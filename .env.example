# ==============================================================================
# RashBot — Environment Variables Template / Modelo de Variáveis de Ambiente
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (Windows PowerShell)
# 2. Fill in your actual credentials.
# 3. NEVER commit the .env file to Git (protected via .gitignore).
# ==============================================================================

# Google Gemini API Key
# Required for LangGraph / LangChain agent invocations.
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Google GenAI Model
# Recommended: gemini-1.5-flash (fast, cost-effective for deterministic tool calling)
# Supported options: gemini-1.5-flash, gemini-2.5-flash, gemini-flash-latest
GEMINI_MODEL=gemini-1.5-flash

# Application Logging Level
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
